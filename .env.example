# Copy this file to .env.local and fill in your free Supabase project credentials.
# Leave unset to run immediately in built-in Local Demo Mode (seeded with all 93 students & banner rules).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional (Server-side only — NEVER expose with NEXT_PUBLIC_):
# Add your Supabase Service Role key here to allow Admin/BK to create new Teacher login accounts directly inside /pengaturan.
SUPABASE_SERVICE_ROLE_KEY=
